@model List<DonguselIz.Web.Models.Domain.WasteBatch>
@using DonguselIz.Web.Services
@{
    ViewData["Title"] = "Partilerim";
}

<div class="page-wrap">
    <div class="page-head">
        <div>
            <div class="page-eyebrow">Saha Atık Girişi</div>
            <h2 class="page-title">Partilerim</h2>
            <p class="page-sub">Tesisinizin bildirdiği tüm partiler ve denetim sonuçları.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">Yeni Parti Bildir</a>
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="flash flash-ok">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="flash flash-error" style="background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem;">@TempData["ErrorMessage"]</div> }

    <div class="panel-card">
        @if (!Model.Any())
        {
            <div class="empty-state">Henüz parti bildirmediniz.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>Lot</th><th>Malzeme</th><th>Hat</th><th>Miktar</th><th>Saflık</th><th>Bildiren</th><th>Durum</th><th>Pasaport</th><th>İşlemler</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var isRevision = b.Status == DonguselIz.Web.Models.Enums.BatchStatus.RevisionRequested;
                        var isEditable = b.Status == DonguselIz.Web.Models.Enums.BatchStatus.AiVerified || isRevision || b.Status == DonguselIz.Web.Models.Enums.BatchStatus.Draft;
                        <tr style="@(isRevision ? "background-color: #fffbeb;" : "")">
                            <td>
                                <strong>@b.LotNo</strong>
                                @if (isRevision)
                                {
                                    <div style="font-size: 0.72rem; color: #b45309; font-weight: 700; margin-top: 0.15rem;">
                                        Revizyon Notu: @b.ReviewNote
                                    </div>
                                }
                            </td>
                            <td>@b.MaterialType</td>
                            <td>@b.ProductionLine</td>
                            <td>@b.WeightKg.ToString("N0") kg</td>
                            <td>%@b.PurityPercent.ToString("0.0")</td>
                            <td>@b.CreatedByName</td>
                            <td><span class="badge @BatchStatusDisplay.CssClass(b.Status)">@BatchStatusDisplay.Label(b.Status)</span></td>
                            <td>@(string.IsNullOrEmpty(b.PassportCode) ? "Henüz yok" : b.PassportCode)</td>
                            <td style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline btn-sm" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;">Detay</a>
                                @if (isEditable)
                                {
                                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; background: @(isRevision ? "#b45309" : "var(--brand-primary)"); color: white; margin-left: 0.25rem;">
                                        Düzenle
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
