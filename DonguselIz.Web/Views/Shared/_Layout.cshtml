<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Döngüsel İz | Gaziantep OSB</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="header-container">
            <div class="header-brand-row">
                <a asp-controller="Demo" asp-action="Index" class="brand-wrapper" style="text-decoration: none;">
                    <img src="~/images/logo.svg" alt="Döngüsel İz Logo" style="width: 46px; height: 46px; display: block;" />
                    <div class="brand-meta">
                        <h1 style="font-size: 1.25rem; font-weight: 800; letter-spacing: -0.025em; line-height: 1.1;">DÖNGÜSEL İZ</h1>
                        <span style="font-size: 0.72rem; letter-spacing: 0.08em; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Gaziantep OSB Malzeme Pasaportu</span>
                    </div>
                </a>

                <button type="button" class="mobile-menu-btn" id="mobileMenuToggleBtn" onclick="toggleMobileMenu()" aria-label="Menüyü Aç veya Kapat" aria-expanded="false">
                    <span class="mobile-menu-icon">
                        <svg class="icon-hamburger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                        <svg class="icon-close" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </span>
                    <span class="mobile-menu-label" id="mobileMenuLabel">Menü</span>
                </button>
            </div>

            @{
                var sessionEmail = Context.Session.GetString("CurrentUserEmail");
                var sessionName = Context.Session.GetString("CurrentUserName");
                var sessionCompany = Context.Session.GetString("CurrentCompany");
                var sessionRole = Context.Session.GetString("CurrentUserRole");

                if (string.IsNullOrEmpty(sessionEmail) && Context.Items.TryGetValue("AuthenticatedEmployee", out var authObj) && authObj is DonguselIz.Web.Models.Domain.CompanyEmployee emp)
                {
                    sessionEmail = emp.Email;
                    sessionName = emp.FullName;
                    sessionCompany = emp.Company?.Name ?? "";
                    sessionRole = emp.Role.ToString();
                }

                var isLoggedIn = !string.IsNullOrEmpty(sessionEmail);
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

                string ActiveClass(string controller, string action = "") =>
                    currentController == controller && (action == "" || currentAction == action)
                        ? "active" : "";
            }

            <div class="header-content-panel" id="headerContentPanel">
                @if (isLoggedIn)
                {
                    <nav class="header-nav">
                        <a asp-controller="Panel" asp-action="Index" class="@ActiveClass("Panel")" onclick="closeMobileMenu()">Panelim</a>
                        @if (sessionRole == "OsbAuditor")
                        {
                            <a asp-controller="Admin" asp-action="Companies" class="@ActiveClass("Admin")" onclick="closeMobileMenu()">Tesis ve Personel</a>
                            <a asp-controller="Batch" asp-action="Audit" asp-route-filter="pending" class="@ActiveClass("Batch", "Audit")" onclick="closeMobileMenu()">Parti Denetimi</a>
                        }
                        else if (sessionRole == "WasteGenerator")
                        {
                            <a asp-controller="Batch" asp-action="Create" class="@ActiveClass("Batch", "Create")" onclick="closeMobileMenu()">Yeni Parti Bildirimi</a>
                            <a asp-controller="Batch" asp-action="Index" class="@ActiveClass("Batch", "Index")" onclick="closeMobileMenu()">Partilerim</a>
                            <a asp-controller="Company" asp-action="Index" class="@ActiveClass("Company")" onclick="closeMobileMenu()">Firmam ve Ekibim</a>
                        }
                        else if (sessionRole == "RecyclerBuyer")
                        {
                            <a asp-controller="Market" asp-action="Index" class="@ActiveClass("Market", "Index")" onclick="closeMobileMenu()">Hammadde Pazarı</a>
                            <a asp-controller="Market" asp-action="Reservations" class="@ActiveClass("Market", "Reservations")" onclick="closeMobileMenu()">Rezervasyonlarım</a>
                            <a asp-controller="Company" asp-action="Index" class="@ActiveClass("Company")" onclick="closeMobileMenu()">Firmam ve Ekibim</a>
                        }
                        <a asp-controller="Climate" asp-action="Index" class="@ActiveClass("Climate")" onclick="closeMobileMenu()">İklim Karnesi</a>
                    </nav>

                    <div class="user-profile-menu">
                        <button type="button" class="profile-trigger" id="profileDropdownBtn" onclick="toggleProfileMenu(event)">
                            <span class="user-avatar">
                                @(string.IsNullOrWhiteSpace(sessionName) ? "K" : sessionName.Substring(0, 1).ToUpper())
                            </span>
                            <span class="user-brief">
                                <span class="user-name">@sessionName</span>
                                <span class="user-role-tag">
                                    @(sessionRole switch {
                                        "OsbAuditor" => "OSB Denetçisi",
                                        "WasteGenerator" => "Üretici Tesis",
                                        "RecyclerBuyer" => "Geri Dönüşümcü",
                                        _ => "Kullanıcı"
                                    })
                                </span>
                            </span>
                            <svg class="chevron-icon" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </button>

                        <div class="profile-dropdown-panel" id="profileDropdownPanel">
                            <div class="profile-panel-header">
                                <div class="profile-large-avatar">
                                    @(string.IsNullOrWhiteSpace(sessionName) ? "K" : sessionName.Substring(0, 1).ToUpper())
                                </div>
                                <div class="profile-panel-user">
                                    <div class="profile-panel-name">@sessionName</div>
                                    <div class="profile-panel-email">@sessionEmail</div>
                                </div>
                            </div>

                            <div class="profile-panel-body">
                                <div class="profile-meta-row">
                                    <span class="profile-meta-label">Bağlı Tesis</span>
                                    <span class="profile-meta-val">@(string.IsNullOrWhiteSpace(sessionCompany) ? "Gaziantep OSB" : sessionCompany)</span>
                                </div>
                                <div class="profile-meta-row">
                                    <span class="profile-meta-label">Yetki Rolü</span>
                                    <span class="profile-meta-val">
                                        @(sessionRole switch {
                                            "OsbAuditor" => "Bölge Denetim Yetkilisi",
                                            "WasteGenerator" => "Sanayi Atık Bildirimcisi",
                                            "RecyclerBuyer" => "Geri Dönüşüm Satın Alıcısı",
                                            _ => "Kullanıcı"
                                        })
                                    </span>
                                </div>
                            </div>

                            <div class="profile-panel-links">
                                @if (sessionRole != "OsbAuditor")
                                {
                                    <a asp-controller="Company" asp-action="Index" class="profile-link-item">
                                        Fabrika ve Ekip Bilgilerim
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Admin" asp-action="Companies" class="profile-link-item">
                                        OSB Tesis Yönetim Masası
                                    </a>
                                }
                            </div>

                            <div class="profile-panel-footer">
                                <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; width: 100%;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="profile-logout-btn">
                                        Güvenli Çıkış Yap
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @if (currentController == "Demo")
                    {
                        <nav class="header-nav">
                            <a href="#isleyis" onclick="closeMobileMenu()">İşleyiş Mimarisi</a>
                            <a href="#akis-haritasi" onclick="closeMobileMenu()">Saha ve Simbiyoz</a>
                            <a href="#roller" onclick="closeMobileMenu()">Kullanıcı Rolleri</a>
                            <a href="#mevzuat" onclick="closeMobileMenu()">Mevzuat ve Standartlar</a>
                        </nav>
                    }
                    else
                    {
                        <nav class="header-nav">
                            <a asp-controller="Demo" asp-action="Index" asp-fragment="isleyis" onclick="closeMobileMenu()">İşleyiş Mimarisi</a>
                            <a asp-controller="Demo" asp-action="Index" asp-fragment="akis-haritasi" onclick="closeMobileMenu()">Saha ve Simbiyoz</a>
                            <a asp-controller="Demo" asp-action="Index" asp-fragment="roller" onclick="closeMobileMenu()">Kullanıcı Rolleri</a>
                            <a asp-controller="Demo" asp-action="Index" asp-fragment="mevzuat" onclick="closeMobileMenu()">Mevzuat ve Standartlar</a>
                        </nav>
                    }

                    <div class="header-actions">
                        @if (currentController == "Account" && currentAction == "Login")
                        {
                            <a class="btn btn-outline btn-sm" asp-controller="Demo" asp-action="Index" onclick="closeMobileMenu()">Ana Sayfaya Dön</a>
                        }
                        else if (currentController == "Account" && currentAction == "Apply")
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login" onclick="closeMobileMenu()">Kurumsal Giriş</a>
                        }
                        else
                        {
                            <a class="btn btn-outline btn-sm" asp-controller="Account" asp-action="Apply" onclick="closeMobileMenu()">Ön Talep / Başvuru</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login" onclick="closeMobileMenu()">Kurumsal Giriş</a>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer style="background-color: var(--slate-900); color: var(--slate-400); border-top: 1px solid var(--slate-800); padding: 3rem 1.5rem; font-size: 0.85rem; margin-top: auto;">
        <div style="max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2rem;">
            <div style="max-width: 440px;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <img src="~/images/logo.svg" alt="Döngüsel İz Logo" style="width: 32px; height: 32px;" />
                    <span style="font-weight: 800; color: var(--white); font-size: 1.1rem; letter-spacing: -0.02em;">DÖNGÜSEL İZ</span>
                </div>
                <p style="color: var(--slate-400); font-size: 0.825rem; line-height: 1.6;">
                    Gaziantep Organize Sanayi Bölgesinde endüstriyel tekstil ve polimer firelerinin kaynağında görsel yapay zeka ile doğrulanmasını ve AB standartlarında Dijital Malzeme Pasaportu ile ikincil hammaddeye dönüştürülmesini sağlayan kurumsal altyapı platformudur.
                </p>
                <div style="margin-top: 0.75rem;">
                    <a asp-controller="Climate" asp-action="Index" style="color: #34d399; text-decoration: none; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem;">
                        🌱 Gaziantep OSB İklim &amp; Karbon Karnesi &rarr;
                    </a>
                </div>
            </div>
            <div>
                <div style="font-weight: 700; color: var(--white); margin-bottom: 0.75rem; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.08em;">Kurumsal İletişim &amp; Denetim</div>
                <div style="font-size: 0.825rem; line-height: 1.7;">
                    Gaziantep Organize Sanayi Bölge Müdürlüğü<br />
                    Çevre ve Sürdürülebilirlik Koordinasyon Merkezi<br />
                    E-Posta: denetim@gazianteposb.org.tr
                </div>
            </div>
        </div>
        <div style="max-width: 1280px; margin: 2rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--slate-800); display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--slate-500);">
            <div>Döngüsel İz &copy; 2026 · Tüm Hakları Saklıdır.</div>
            <div>AB ESPR &amp; SKDM Çerçevesiyle Uyumlu Dijital Altyapı</div>
        </div>
    </footer>

    <script>
        function toggleProfileMenu(e) {
            e.stopPropagation();
            var panel = document.getElementById('profileDropdownPanel');
            var btn = document.getElementById('profileDropdownBtn');
            if (!panel) return;
            var isOpen = panel.classList.contains('show');
            if (isOpen) {
                panel.classList.remove('show');
                if (btn) btn.classList.remove('active');
            } else {
                panel.classList.add('show');
                if (btn) btn.classList.add('active');
            }
        }

        document.addEventListener('click', function(e) {
            var panel = document.getElementById('profileDropdownPanel');
            var btn = document.getElementById('profileDropdownBtn');
            if (panel && panel.classList.contains('show')) {
                if (!panel.contains(e.target) && !btn.contains(e.target)) {
                    panel.classList.remove('show');
                    if (btn) btn.classList.remove('active');
                }
            }
        });

        function toggleMobileMenu() {
            var panel = document.getElementById('headerContentPanel');
            var btn = document.getElementById('mobileMenuToggleBtn');
            var iconHam = btn ? btn.querySelector('.icon-hamburger') : null;
            var iconClose = btn ? btn.querySelector('.icon-close') : null;
            var label = document.getElementById('mobileMenuLabel');
            
            if (!panel) return;
            var isOpen = panel.classList.contains('mobile-open');
            
            if (isOpen) {
                closeMobileMenu();
            } else {
                panel.classList.add('mobile-open');
                if (btn) {
                    btn.classList.add('active');
                    btn.setAttribute('aria-expanded', 'true');
                }
                if (iconHam) iconHam.style.display = 'none';
                if (iconClose) iconClose.style.display = 'inline-block';
                if (label) label.textContent = 'Kapat';
            }
        }

        function closeMobileMenu() {
            var panel = document.getElementById('headerContentPanel');
            var btn = document.getElementById('mobileMenuToggleBtn');
            var iconHam = btn ? btn.querySelector('.icon-hamburger') : null;
            var iconClose = btn ? btn.querySelector('.icon-close') : null;
            var label = document.getElementById('mobileMenuLabel');

            if (panel) {
                panel.classList.remove('mobile-open');
            }
            if (btn) {
                btn.classList.remove('active');
                btn.setAttribute('aria-expanded', 'false');
            }
            if (iconHam) iconHam.style.display = 'inline-block';
            if (iconClose) iconClose.style.display = 'none';
            if (label) label.textContent = 'Menü';
        }

        // Mobil menü açıkken sayfa dışına veya linklere tıklandığında menüyü otomatik kapat
        document.addEventListener('click', function(e) {
            var panel = document.getElementById('headerContentPanel');
            var btn = document.getElementById('mobileMenuToggleBtn');
            if (panel && panel.classList.contains('mobile-open')) {
                if (!panel.contains(e.target) && !btn.contains(e.target)) {
                    closeMobileMenu();
                }
            }
        });

        function togglePasswordVisibility(btn) {
            var wrapper = btn.closest('.password-field-wrapper');
            if (!wrapper) return;
            var input = wrapper.querySelector('input');
            if (!input) return;
            var eyeOpen = btn.querySelector('.eye-open');
            var eyeClosed = btn.querySelector('.eye-closed');
            
            if (input.type === 'password') {
                input.type = 'text';
                if (eyeOpen) eyeOpen.style.display = 'none';
                if (eyeClosed) eyeClosed.style.display = 'inline-block';
            } else {
                input.type = 'password';
                if (eyeOpen) eyeOpen.style.display = 'inline-block';
                if (eyeClosed) eyeClosed.style.display = 'none';
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
