@model DonguselIz.Web.Models.ViewModels.CompanyProfileViewModel
@{
    ViewData["Title"] = "Firmam ve Ekibim";
    var c = Model.Company;
    var isBuyer = c.PrimaryRole == DonguselIz.Web.Models.Enums.UserRole.RecyclerBuyer;
}

<div class="page-wrap">
    <div class="page-head">
        <div>
            <div class="page-eyebrow">Firmam</div>
            <h2 class="page-title">@c.Name</h2>
            <p class="page-sub">@c.OsbRegion · VKN @c.TaxNumber · @(Model.IsManager ? "Firma yöneticisi olarak oturum açtınız." : "Ekip üyesi olarak oturum açtınız.")</p>
        </div>
        @if (isBuyer)
        {
            <a asp-controller="Market" asp-action="Reservations" class="btn btn-outline btn-sm">Rezervasyonlarım</a>
        }
        else
        {
            <a asp-controller="Batch" asp-action="Index" class="btn btn-outline btn-sm">Firmamın Partileri</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="flash flash-ok">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="flash flash-err">@TempData["ErrorMessage"]</div> }

    <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div class="stat-label">@(isBuyer ? "Rezerve Edilen Parti" : "Bildirilen Parti")</div>
            <div class="stat-value">@Model.TotalBatches</div>
            <div class="stat-hint">Firmanız adına kayıtlı</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Toplam Miktar</div>
            <div class="stat-value">@((Model.TotalWeightKg / 1000.0).ToString("0.0")) ton</div>
            <div class="stat-hint">Tüm partilerin toplamı</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Ekip</div>
            <div class="stat-value">@c.Employees.Count</div>
            <div class="stat-hint">Tanımlı kullanıcı</div>
        </div>
    </div>

    <div class="panel-card">
        <h3>Çıktı ve Kapasite Bilgileri</h3>
        @if (Model.IsManager)
        {
            <form asp-action="UpdateProfile" method="post">
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">@(isBuyer ? "Aldığınız veya Ürettiğiniz Malzemeler" : "Çıktı ve Atık Türleri")</label>
                        <input name="outputMaterialTypes" value="@c.OutputMaterialTypes" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Aylık Kapasite (ton)</label>
                        <input name="monthlyOutputCapacityTons" type="number" step="0.1" min="0" value="@c.MonthlyOutputCapacityTons.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Tesis Adresi</label>
                    <input name="facilityAddress" value="@c.FacilityAddress" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Bilgileri Kaydet</button>
            </form>
        }
        else
        {
            <div class="kv">
                <div><label>Çıktı ve Atık Türleri</label><span>@c.OutputMaterialTypes</span></div>
                <div><label>Aylık Kapasite</label><span>@c.MonthlyOutputCapacityTons.ToString("0.#") ton</span></div>
                <div><label>Tesis Adresi</label><span>@(string.IsNullOrWhiteSpace(c.FacilityAddress) ? "Girilmemiş" : c.FacilityAddress)</span></div>
            </div>
            <p style="font-size: 0.8rem; color: var(--slate-500); margin-top: 1rem;">Bu bilgileri yalnızca firma yöneticisi değiştirebilir.</p>
        }
    </div>

    <div class="panel-card">
        <h3>Ekibim</h3>
        <table class="data-table">
            <thead>
                <tr><th>Ad Soyad</th><th>Görev</th><th>E-posta</th><th>Yetki</th><th>Bildirdiği Parti</th><th>Durum</th>@if (Model.IsManager) {<th></th>}</tr>
            </thead>
            <tbody>
                @foreach (var e in c.Employees.OrderByDescending(x => x.IsCompanyManager).ThenBy(x => x.FullName))
                {
                    var count = Model.BatchCountByPerson.TryGetValue(e.FullName, out var n) ? n : 0;
                    <tr>
                        <td><strong>@e.FullName</strong>@(e.Id == Model.CurrentEmployeeId ? " (siz)" : "")</td>
                        <td>@e.Title</td>
                        <td>@e.Email</td>
                        <td><span class="badge @(e.IsCompanyManager ? "badge-info" : "badge-muted")">@(e.IsCompanyManager ? "Yönetici" : "Personel")</span></td>
                        <td>@count</td>
                        <td><span class="badge @(e.IsActive ? "badge-ok" : "badge-danger")">@(e.IsActive ? "Aktif" : "Pasif")</span></td>
                        @if (Model.IsManager)
                        {
                            <td>
                                <details>
                                    <summary style="cursor: pointer; color: var(--brand-primary); font-weight: 700; font-size: 0.8rem;">Düzenle</summary>
                                    <form asp-action="EditStaff" method="post" style="margin-top: 0.6rem; display: grid; gap: 0.4rem; min-width: 240px;">
                                        <input type="hidden" name="employeeId" value="@e.Id" />
                                        <input name="fullName" value="@e.FullName" class="form-control" placeholder="Ad soyad" required />
                                        <input name="title" value="@e.Title" class="form-control" placeholder="Görev" />
                                        <input name="phoneNumber" value="@e.PhoneNumber" class="form-control" placeholder="Telefon" />
                                        <div class="password-field-wrapper">
                                            <input name="newPassword" type="password" class="form-control" placeholder="Yeni şifre, boşsa değişmez" />
                                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this)" title="Şifreyi Göster veya Gizle" aria-label="Şifreyi Göster">
                                                <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                </svg>
                                                <svg class="eye-closed" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                                </svg>
                                            </button>
                                        </div>
                                        @if (e.Id != Model.CurrentEmployeeId)
                                        {
                                            <label style="font-size: 0.8rem;"><input type="checkbox" name="isActive" value="true" @(e.IsActive ? "checked" : "") /> Hesap aktif</label>
                                            <label style="font-size: 0.8rem;"><input type="checkbox" name="isManager" value="true" @(e.IsCompanyManager ? "checked" : "") /> Firma yöneticisi</label>
                                        }
                                        <button type="submit" class="btn btn-primary btn-sm">Kaydet</button>
                                    </form>
                                    @if (e.Id != Model.CurrentEmployeeId)
                                    {
                                        <form asp-action="DeleteStaff" method="post" onsubmit="return confirm('Bu kullanıcının erişimi silinecek. Devam edilsin mi?');" style="margin-top: 0.4rem;">
                                            <input type="hidden" name="employeeId" value="@e.Id" />
                                            <button type="submit" style="background: none; border: none; color: #991b1b; font-weight: 700; font-size: 0.8rem; cursor: pointer; padding: 0;">Kullanıcıyı Sil</button>
                                        </form>
                                    }
                                </details>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.IsManager)
    {
        <div class="panel-card">
            <h3>Ekibe Yeni Kişi Ekle</h3>
            <form asp-action="AddStaff" method="post">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group"><label class="form-label">Ad Soyad</label><input name="fullName" class="form-control" required /></div>
                    <div class="form-group"><label class="form-label">Kurumsal E-posta</label><input name="email" type="email" class="form-control" required /></div>
                    <div class="form-group"><label class="form-label">Görev</label><input name="title" class="form-control" value="Vardiya ve Atık Sorumlusu" /></div>
                    <div class="form-group"><label class="form-label">Telefon</label><input name="phoneNumber" class="form-control" /></div>
                    <div class="form-group">
                        <label class="form-label">İlk Şifre, en az 8 karakter</label>
                        <div class="password-field-wrapper">
                            <input name="password" type="password" class="form-control" minlength="8" required />
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this)" title="Şifreyi Göster veya Gizle" aria-label="Şifreyi Göster">
                                <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-closed" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Ekibe Ekle</button>
            </form>
        </div>
    }
</div>
