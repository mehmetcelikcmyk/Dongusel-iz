@model DonguselIz.Web.Models.ViewModels.CompanyApplicationViewModel
@{
    ViewData["Title"] = "OSB Ekosistemine Katılım Başvurusu";
}

<div class="auth-container" style="max-width: 720px; margin: 3rem auto;">
    <div class="auth-card">
        <div class="auth-header">
            <img src="~/images/logo.svg" alt="Döngüsel İz Logo" style="width: 64px; height: 64px; margin: 0 auto 1.25rem; display: block;" />
            <h2>OSB Ekosistemine Katılım Başvurusu</h2>
            <p>Gaziantep Organize Sanayi Bölgesi Dijital Malzeme Pasaportu Ön Talep Formu</p>
        </div>

        <div style="background-color: var(--slate-50); border: 1px solid var(--border); border-radius: 8px; padding: 0.85rem 1.1rem; margin-bottom: 1.5rem; font-size: 0.825rem; color: var(--slate-600); line-height: 1.5;">
            <strong>Bilgilendirme:</strong> Başvurunuz Gaziantep OSB Çevre ve Sürdürülebilirlik Masası tarafından incelenerek Çevre İzin ve Lisans teyidi sağlandıktan sonra kurumsal e-posta adresinize resmi giriş yetkisi tanımlanır.
        </div>

        <form asp-action="Apply" method="post" id="apply-form">
            <div asp-validation-summary="ModelOnly" style="color: var(--status-danger); font-size: 0.825rem; margin-bottom: 1rem;"></div>

            <div class="form-group">
                <label asp-for="CompanyName" class="form-label"></label>
                <input asp-for="CompanyName" class="form-control" placeholder="Firma resmi ünvanı" />
                <span asp-validation-for="CompanyName" style="color: var(--status-danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                <div class="form-group">
                    <label asp-for="TaxNumber" class="form-label"></label>
                    <input asp-for="TaxNumber" class="form-control" placeholder="10 Haneli VKN" maxlength="10" />
                    <span asp-validation-for="TaxNumber" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OsbRegion" class="form-label"></label>
                    <select asp-for="OsbRegion" class="form-control">
                        <option value="Gaziantep OSB 1. Bölge">Gaziantep OSB 1. Bölge</option>
                        <option value="Gaziantep OSB 2. Bölge">Gaziantep OSB 2. Bölge</option>
                        <option value="Gaziantep OSB 3. Bölge">Gaziantep OSB 3. Bölge</option>
                        <option value="Gaziantep OSB 4. Bölge">Gaziantep OSB 4. Bölge</option>
                        <option value="Gaziantep OSB 5. Bölge">Gaziantep OSB 5. Bölge</option>
                        <option value="Küsget Küçük Sanayi Sitesi">Küsget Küçük Sanayi Sitesi</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                <div class="form-group">
                    <label asp-for="ContactFullName" class="form-label"></label>
                    <input asp-for="ContactFullName" class="form-control" placeholder="Tesis Yetkilisi Ad Soyad" />
                    <span asp-validation-for="ContactFullName" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0 342 000 00 00" />
                    <span asp-validation-for="PhoneNumber" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="yetkili@fabrika.com.tr" />
                    <span asp-validation-for="Email" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RequestedRole" class="form-label"></label>
                    <select asp-for="RequestedRole" class="form-control">
                        <option value="@DonguselIz.Web.Models.Enums.UserRole.WasteGenerator">Üretici Tesis (Fire Çıkışı)</option>
                        <option value="@DonguselIz.Web.Models.Enums.UserRole.RecyclerBuyer">Geri Dönüşümcü (Hammadde Alımı)</option>
                    </select>
                </div>
            </div>

            <!-- Şifre Belirleme Alanları -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                <div class="form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="password-field-wrapper">
                        <input asp-for="Password" type="password" class="form-control" placeholder="En az 6 karakterli şifreniz" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this)" title="Şifreyi Göster veya Gizle" aria-label="Şifreyi Göster">
                            <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="password-field-wrapper">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Şifrenizi tekrar yazınız" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this)" title="Şifreyi Göster veya Gizle" aria-label="Şifreyi Göster">
                            <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" style="color: var(--status-danger); font-size: 0.75rem;"></span>
                </div>
            </div>

            <!-- Checkbox ve 'Diğer' Malzeme Seçim Alanı -->
            <div class="form-group">
                <label class="form-label">Üretilen veya Talep Edilen Malzeme Türleri</label>
                <div style="font-size: 0.75rem; color: var(--slate-500); margin-bottom: 0.6rem;">Tesisinizin faaliyet alanına giren kategorileri işaretleyin veya özel malzeme tanımlayın:</div>
                
                <div style="background-color: var(--slate-50); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem;">
                    <!-- Ön Tanımlı Standart Kategoriler -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border);" id="material-checkbox-container">
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--slate-700); cursor: pointer;">
                            <input type="checkbox" class="mat-checkbox" value="Polipropilen (PP) Dokuma Firesi" onchange="syncMaterials()" />
                            <span>Polipropilen (PP) Dokuma Firesi</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--slate-700); cursor: pointer;">
                            <input type="checkbox" class="mat-checkbox" value="Ham Penye Pamuk Telefi" onchange="syncMaterials()" />
                            <span>Ham Penye Pamuk Telefi</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--slate-700); cursor: pointer;">
                            <input type="checkbox" class="mat-checkbox" value="LDPE Ambalaj Streç Filmi" onchange="syncMaterials()" />
                            <span>LDPE Ambalaj Streç Filmi</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--slate-700); cursor: pointer;">
                            <input type="checkbox" class="mat-checkbox" value="Polyester (PES) İplik Kırpıntısı" onchange="syncMaterials()" />
                            <span>Polyester (PES) İplik Kırpıntısı</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--slate-700); cursor: pointer;">
                            <input type="checkbox" class="mat-checkbox" value="Oluklu Mukavva & Koli Firesi" onchange="syncMaterials()" />
                            <span>Oluklu Mukavva &amp; Koli Firesi</span>
                        </label>
                    </div>

                    <!-- Kutu İçindeki Dinamik Diğer Malzeme Girişleri -->
                    <div style="margin-top: 1rem;">
                        <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-600); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            Özel / Diğer Malzemeler (Yazdıkça yeni satır açılır)
                        </div>
                        <div id="dynamic-other-container" style="display: flex; flex-direction: column; gap: 0.5rem;">
                            <div class="other-row" style="display: flex; gap: 0.6rem; align-items: center;">
                                <input type="checkbox" class="other-check" onchange="syncMaterials()" />
                                <input type="text" class="form-control other-text" style="padding: 0.45rem 0.75rem; font-size: 0.825rem; background: var(--white);" placeholder="Diğer malzeme türünü yazınız..." oninput="handleOtherInput(this)" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sunucuya gidecek birleşik alan -->
                <input type="hidden" asp-for="WasteOrMaterialDescription" id="WasteOrMaterialDescription" />
                <span asp-validation-for="WasteOrMaterialDescription" style="color: var(--status-danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.8rem; color: var(--slate-600); cursor: pointer;">
                    <input type="checkbox" asp-for="TermsAccepted" style="margin-top: 0.2rem;" />
                    <span>Tesisimizin Gaziantep Organize Sanayi Bölgesinde yer aldığını, beyan edilen verilerin doğruluğunu ve OSB Denetim Protokolünü kabul ediyorum.</span>
                </label>
                <span asp-validation-for="TermsAccepted" style="color: var(--status-danger); font-size: 0.75rem;"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.75rem;">
                Ön Başvuru Talebini Gönder
            </button>

            <div style="text-align: center; font-size: 0.825rem; color: var(--slate-500); margin-top: 1.25rem;">
                Zaten tanımlı hesabınız var mı? <a asp-action="Login" style="font-weight: 700;">Giriş Yap</a>
            </div>
        </form>
    </div>
</div>

<script>
    function syncMaterials() {
        const selected = [];
        
        // Standart checkboxlar
        document.querySelectorAll('.mat-checkbox:checked').forEach(cb => {
            selected.push(cb.value);
        });

        // Dinamik diğer inputları
        document.querySelectorAll('.other-row').forEach(row => {
            const chk = row.querySelector('.other-check');
            const txt = row.querySelector('.other-text');
            if (chk && chk.checked && txt && txt.value.trim() !== '') {
                selected.push(txt.value.trim());
            }
        });

        document.getElementById('WasteOrMaterialDescription').value = selected.join(' | ');
    }

    function handleOtherInput(inputElem) {
        const row = inputElem.closest('.other-row');
        const chk = row.querySelector('.other-check');
        const hasText = inputElem.value.trim().length > 0;

        // Metin yazıldığı an checkbox otomatik seçilsin, metin silinirse kalksın
        chk.checked = hasText;
        syncMaterials();

        // Eğer yazılan satır son satırsa ve metin varsa, yeni boş bir satır aç (ancak yeni açılan satır seçili OLMASIN)
        const container = document.getElementById('dynamic-other-container');
        const allRows = container.querySelectorAll('.other-row');
        const isLastRow = (row === allRows[allRows.length - 1]);

        if (hasText && isLastRow) {
            const newRow = document.createElement('div');
            newRow.className = 'other-row';
            newRow.style = 'display: flex; gap: 0.6rem; align-items: center; margin-top: 0.25rem;';
            newRow.innerHTML = `
                <input type="checkbox" class="other-check" onchange="syncMaterials()" />
                <input type="text" class="form-control other-text" style="padding: 0.45rem 0.75rem; font-size: 0.825rem; background: var(--white);" placeholder="Bir diğer malzeme türü daha ekleyin..." oninput="handleOtherInput(this)" />
            `;
            container.appendChild(newRow);
        }
    }

    document.getElementById('apply-form').addEventListener('submit', function() {
        syncMaterials();
    });
</script>
