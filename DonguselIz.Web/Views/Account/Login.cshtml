@model DonguselIz.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Yetkili Girişi";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="~/images/logo.svg" alt="Döngüsel İz Logo" style="width: 64px; height: 64px; margin: 0 auto 1.25rem; display: block;" />
            <h2>Tesis &amp; Yetkili Girişi</h2>
            <p>Gaziantep OSB Malzeme Pasaportu Ekosistemi</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 0.85rem 1rem; border-radius: 8px; font-size: 0.85rem; margin-bottom: 1.5rem; line-height: 1.5;">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" style="color: var(--status-danger); font-size: 0.825rem; margin-bottom: 1rem;"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="ad.soyad@fabrika.com.tr" autocomplete="username" />
                <span asp-validation-for="Email" style="color: var(--status-danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-field-wrapper">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Parolanız" autocomplete="current-password" />
                    <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this)" title="Şifreyi Göster veya Gizle" aria-label="Şifreyi Göster">
                        <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" style="color: var(--status-danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--slate-600); cursor: pointer;">
                    <input type="checkbox" asp-for="RememberMe" />
                    Beni hatırla
                </label>
                <a href="#" style="font-size: 0.8rem;">Erişim İzni / Şifremi Unuttum</a>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-bottom: 1.25rem;">
                Sisteme Güvenli Giriş Yap
            </button>

            <!-- Tesis Katılım Başvurusu / Ön Talep Butonu -->
            <div style="border-top: 1px solid var(--border); padding-top: 1.25rem; text-align: center;">
                <div style="font-size: 0.825rem; color: var(--slate-600); margin-bottom: 0.75rem;">
                    Tesisiniz henüz ekosisteme kayıtlı değil mi?
                </div>
                <a asp-action="Apply" class="btn btn-outline" style="width: 100%; font-size: 0.825rem;">
                    OSB Katılım Başvurusu / Ön Talep Formu
                </a>
            </div>
        </form>
    </div>
</div>
